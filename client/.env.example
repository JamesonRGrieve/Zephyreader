# Copy to `.env` and fill in the blanks. `.env` is gitignored — never commit real secrets.

# Which version this build is: `lite` (self-hosted; this app answers /api/v1 itself, the
# default) or `saas` (the same UI; /api/v1 is proxied to the Python server in ../server).
ZEPHYREADER_VARIANT=lite
# saas only: where the Python server listens (default http://127.0.0.1:6970).
ZEPHYREADER_SERVER_URI=

# Public origin; the OAuth redirect defaults to ${APP_URI}/user/close/google. The API
# (/api, same-origin) and auth paths live in src/zephyrex.config.ts, not env.
APP_URI=http://localhost:6969
# The port `next start` listens on (default 6969).
PORT=
# Optional: more comma-separated routes that require a signed-in user (the app's own pages always do).
PRIVATE_ROUTES=
# Optional: where the server reaches its own API for the session check
# (default http://127.0.0.1:${PORT}/api).
API_UPSTREAM_URL=
# Optional: the domain the session cookies are set for (default: this host only).
SESSION_COOKIE_DOMAIN=
# Optional: the paid-plan waitlist. The ERP's guest Web Form that /api/waitlist passes signups to
# as CRM leads (Zephyrex's is waitlist-zephyreader). Unset, there is no waitlist (404), as on lite.
WAITLIST_WEB_FORM=
# The ERP site that form is on (default https://erp.zephyrex.ca).
WAITLIST_ERP_URL=

# --- lite only: sign-in, sessions and storage (the saas server has its own settings) ---

# Google OAuth / OIDC sign-in (also grants Drive read access for importing Docs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: another OpenID issuer to sign in with instead of Google (discovered from it).
GOOGLE_ISSUER=
# Exact-match redirect URI allowlist (comma-separated). Defaults to ${APP_URI}/user/close/google.
OAUTH_REDIRECT_URIS=
# Create an account on first sign-in with a verified email (default true).
OAUTH_ALLOW_SIGNUP=true
# 32 random bytes, base64 (`openssl rand -base64 32`): encrypts stored IdP tokens.
OAUTH_TOKEN_ENCRYPTION_KEY=
# Signs session tokens (HS256): at least 32 characters (`openssl rand -base64 48`); a
# shorter one is refused.
JWT_SECRET=

# SQLite database (Prisma); apply migrations with `pnpm prisma migrate deploy`.
DATABASE_URL=file:./oauth2.db

# light or dark, for anyone who has not chosen.
DEFAULT_THEME_MODE=dark
