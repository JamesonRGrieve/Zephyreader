#
# Podman/Buildah image for Zephyreader (OCI format; no Docker-only instructions).
#
# The Zephyrex packages (zephyrex, @zephyrex/auth, @jgrieve/forms, zod2gql) are not
# on a registry yet, so they install as injected `file:` copies of the sibling
# checkouts' compiled dist/ (pnpm-workspace.yaml overrides). The siblings come in
# as named build contexts, laid out beside the app exactly as on disk, and are
# compiled leaf-first because each injected install copies the dist/ of the ones
# before it:
#
#   podman build -f Containerfile -t zephyreader \
#     --build-context zod2gql=../../zod2gql \
#     --build-context dynamic-form=../../dynamic-form \
#     --build-context auth=../../auth \
#     --build-context client-framework=../../client-framework \
#     --build-context contract=../contract \
#     --build-arg APP_URI=https://prompt.example.com .
#
# `contract` is the repository's contract/ directory, the knowledge the app shares with
# the SaaS server (read at build time; next.config.js widens the build root to include it).
#
# Run (the SQLite database lives on a volume; migrate once per schema change):
#   podman volume create zephyreader-data
#   podman run --rm -v zephyreader-data:/data --env-file .env localhost/zephyreader-migrate
#   podman run -d -p 6969:6969 -v zephyreader-data:/data --env-file .env \
#     --health-cmd 'node -e "fetch(\"http://127.0.0.1:6969/api/v1/alive\").then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"' \
#     localhost/zephyreader
# (build the migrate image with `--target migrate -t zephyreader-migrate`). Secrets
# (JWT_SECRET, GOOGLE_CLIENT_SECRET, OAUTH_TOKEN_ENCRYPTION_KEY) are supplied at run
# time only; .containerignore keeps .env files out of the build context.

ARG NODE_IMAGE=docker.io/library/node:24-bookworm-slim
ARG PNPM_VERSION=11.1.1
# Public origin: inlined by the build and read at runtime (OAuth redirect base).
ARG APP_URI=http://localhost:6969

FROM ${NODE_IMAGE} AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NEXT_TELEMETRY_DISABLED=1
RUN npm install --global --no-fund --no-audit "pnpm@${PNPM_VERSION}"
WORKDIR /src

# ---- sibling packages: build each dist/ where the `file:../../<name>` overrides expect (the app sits two levels down, as client/ of the repo) ----
# Exclusions are recursive (**/): client-framework is a pnpm workspace whose library
# lives in packages/zephyrex, with its own node_modules and dist/ (and dist.next/
# while compiling) below the root.
FROM base AS siblings
COPY --from=zod2gql --exclude=**/node_modules --exclude=**/dist --exclude=**/dist.next --exclude=.git \
     . /src/zod2gql/
RUN cd /src/zod2gql && pnpm install --frozen-lockfile && pnpm run compile
COPY --from=dynamic-form --exclude=**/node_modules --exclude=**/dist --exclude=**/dist.next --exclude=.git \
     --exclude=**/storybook-static . /src/dynamic-form/
RUN cd /src/dynamic-form && pnpm install --frozen-lockfile && pnpm run compile
COPY --from=auth --exclude=**/node_modules --exclude=**/dist --exclude=**/dist.next --exclude=.git \
     --exclude=**/storybook-static . /src/auth/
RUN cd /src/auth && pnpm install --frozen-lockfile && pnpm run compile
COPY --from=client-framework --exclude=**/node_modules --exclude=**/dist --exclude=**/dist.next \
     --exclude=**/.next --exclude=.git --exclude=**/storybook-static --exclude=**/test-results \
     --exclude=**/playwright-report . /src/client-framework/
# The root `compile` delegates to the zephyrex workspace package (packages/zephyrex/dist).
RUN cd /src/client-framework && pnpm install --frozen-lockfile && pnpm run compile

# ---- app dependencies (cached until the manifest or lockfile changes) ----
FROM siblings AS deps
WORKDIR /src/zephyreader/client
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

# ---- build ----
FROM deps AS builder
# Public URLs are inlined into the client bundle at build time (next.config.js `env`).
ARG APP_URI
ARG DEFAULT_THEME_MODE=dark
ENV APP_URI=${APP_URI} \
    DEFAULT_THEME_MODE=${DEFAULT_THEME_MODE} \
    NEXT_OUTPUT_STANDALONE=1
COPY --from=contract . /src/zephyreader/contract/
COPY . .
# public/ holds only what is fetched into it (the voice model, scripts/fetch-voice-model.mjs);
# it exists either way, for the runtime stage to copy.
RUN mkdir -p public && pnpm run build

# ---- one-off schema migration (`podman build --target migrate`) ----
FROM builder AS migrate
ENV DATABASE_URL=file:/data/zephyreader.db
VOLUME /data
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

# ---- runtime: the traced standalone server only, as a non-root user ----
FROM ${NODE_IMAGE} AS runner
ARG APP_URI
# APP_URI defaults to the build's value so the image runs as built (override with
# --env-file / -e). The middleware's session check reaches the in-process API at
# http://127.0.0.1:${PORT}/api (API_UPSTREAM_URL overrides).
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=6969 \
    HOSTNAME=0.0.0.0 \
    DATABASE_URL=file:/data/zephyreader.db \
    APP_URI=${APP_URI}
# The standalone output is traced from the repository root, so the server sits in its
# client/ directory; the injected packages live in the app's own node_modules there.
WORKDIR /srv/app/client
COPY --from=builder --chown=node:node /src/zephyreader/client/.next/standalone /srv/app/
COPY --from=builder --chown=node:node /src/zephyreader/client/.next/static /srv/app/client/.next/static
COPY --from=builder --chown=node:node /src/zephyreader/client/public /srv/app/client/public
# Read from the working directory at request time by /docs/privacy.
COPY --from=builder --chown=node:node /src/zephyreader/client/src/content /srv/app/client/src/content
COPY --from=builder --chown=node:node /src/zephyreader/client/server-wrapper.js /srv/app/client/server-wrapper.js
RUN mkdir -p /data && chown node:node /data
VOLUME /data
USER node
EXPOSE 6969
CMD ["node", "server-wrapper.js"]
