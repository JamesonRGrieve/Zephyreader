// Mirrors the server-framework auth model this app stands in for: users, external
// IdP links (tokens encrypted at rest), revocable sessions, and single-use OAuth
// authorization state (PKCE verifier + OIDC nonce).

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  firstName   String?
  lastName    String?
  displayName String?
  imageUrl    String?
  timezone    String?
  language    String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  oauthLinks  OAuthLink[]
  sessions    Session[]
}

/// A user's identity at an external IdP, keyed on the IdP's stable subject, never email.
model OAuthLink {
  id             String    @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  email          String?
  /// AES-256-GCM ciphertext (see src/lib/auth/crypto.ts); never stored in the clear.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// A login session. Its id is the session_key, carried in the JWT as `jti`.
model Session {
  id        String   @id @default(uuid())
  userId    String
  grantType String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One in-flight OAuth authorization. Single-use: deleted when the callback consumes it.
model OAuthState {
  stateHash    String   @id
  bindingHash  String
  provider     String
  redirectUri  String
  codeVerifier String
  nonce        String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// Teleprompter records: the same resources, fields and rules as the SaaS server's
// teleprompter extension (server/extensions/teleprompter), owned by their creator.

model ScriptFolder {
  id          String   @id @default(uuid())
  createdById String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?
  scripts     Script[]

  @@index([createdById])
}

model Script {
  id             String        @id @default(uuid())
  createdById    String
  scriptFolderId String?
  title          String
  content        String        @default("")
  starred        Boolean       @default(false)
  wordCount      Int           @default(0)
  sourceProvider String?
  sourcePath     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  updatedById    String?
  scriptFolder   ScriptFolder? @relation(fields: [scriptFolderId], references: [id], onDelete: SetNull)

  @@index([createdById])
}

/// One per user: the display and scroll settings the prompter opens with.
model PrompterPreference {
  id          String   @id @default(uuid())
  createdById String   @unique
  settings    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?
}
