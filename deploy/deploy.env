# Build-time settings for the client prod-zephyreader runs. Next fixes these at build: the
# public origin is inlined into the bundle, and the /api/v1 rewrite to the server is
# compiled into the standalone server's routes.
ZEPHYREADER_VARIANT=saas
APP_URI=https://zephyreader.com
ZEPHYREADER_SERVER_URI=http://127.0.0.1:6970
DEFAULT_THEME_MODE=dark
