# Copy to `.env` and fill in the blanks. `.env` is gitignored — never commit real secrets.
APP_NAME=Open Teleprompt
APP_DESCRIPTION=An open source teleprompting software.
# Names follow the Zephyrex framework. APP_URI, AUTH_URI and PRIVATE_ROUTES are also
# read at request time by the @zephyrex/auth middleware, so the running server needs them.
APP_URI=http://localhost:6969
# Root of the framework's auth UI (login, OAuth close pages).
AUTH_URI=http://localhost:6969/user
# API prefix; clients append server-framework style /v1/... paths (src/app/api/v1/*).
API_URI=http://localhost:6969/api
# Comma-separated routes that require a signed-in user.
PRIVATE_ROUTES=/settings,/team

# Google OAuth / OIDC login (also grants Drive read access for Docs listing/import).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact-match redirect URI allowlist (comma-separated). Defaults to ${AUTH_URI}/close/google.
OAUTH_REDIRECT_URIS=
# Create an account on first sign-in with a verified email (default true).
OAUTH_ALLOW_SIGNUP=true
# 32 random bytes, base64 (`openssl rand -base64 32`): encrypts stored IdP tokens.
OAUTH_TOKEN_ENCRYPTION_KEY=

# Secret used to sign/verify session JWTs (HS256).
JWT_SECRET=

# SQLite database (Prisma); apply migrations with `pnpm prisma migrate deploy`.
DATABASE_URL=file:./oauth2.db

NEXT_ANALYZE=false
DEFAULT_THEME_MODE=dark
ALLOW_BASIC_SIGN_IN=false
ALLOW_MAGICAL_SIGN_IN=false
MODE=development
