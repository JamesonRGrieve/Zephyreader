# Copy to `.env` and fill in the blanks. `.env` is gitignored — never commit real secrets.
APP_NAME=Open Teleprompt
APP_DESCRIPTION=An open source teleprompting software.
APP_URI=http://localhost:6969
AUTH_WEB=http://localhost:6969/user
# Base for the app's own versioned API routes (src/app/api/v1/*).
AUTH_SERVER=http://localhost:6969/api/v1

# Google OAuth (required for Google Docs listing/import).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign/verify session JWTs.
JWT_SECRET=

NEXT_ANALYZE=false
DEFAULT_THEME_MODE=dark
ALLOW_BASIC_SIGN_IN=false
ALLOW_MAGICAL_SIGN_IN=false
MODE=development
