{
  "name": "zephyreader",
  "version": "1.0.0",
  "description": "OpenTeleprompt — a teleprompter built as a Zephyrex framework consumer.",
  "author": "Jameson R Grieve",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesonRGrieve/Zephyreader.git"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "rimraf ./.next && next dev --webpack -p 6969",
    "prebuild": "prisma generate",
    "build": "rimraf ./.next && next build --webpack",
    "start": "next start -p 6969",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "prettier": "prettier .",
    "prettier-fix": "prettier --write .",
    "fix": "prettier --write . && next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "storybook-build": "storybook build",
    "storybook-run": "npx http-server storybook-static -p 6006",
    "storybook-test": "test-storybook --url http://localhost:6006"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@zephyrex/zod2gql": "link:../zod2gql",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "dotenv": "^17.4.2",
    "event-source-polyfill": "^1.0.31",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.39.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "zephyrex": "link:../client-framework"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/nextjs": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prisma": "^6.19.0",
    "rimraf": "^6.1.3",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
