{
  "name": "zephyreader",
  "version": "1.0.0",
  "description": "OpenTeleprompt — a teleprompter built as a Zephyrex framework consumer.",
  "author": "Jameson R Grieve",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesonRGrieve/Zephyreader.git"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "rimraf ./.next && next dev -p 6969",
    "prebuild": "prisma generate",
    "build": "rimraf ./.next && next build",
    "start": "next start -p 6969",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "prettier": "prettier .",
    "prettier-fix": "prettier --write .",
    "fix": "prettier --write . && eslint . --fix",
    "typecheck": "tsc --noEmit",
    "refresh:zephyrex": "pnpm update --no-save zephyrex @zephyrex/auth @jgrieve/forms zod2gql",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "storybook-build": "storybook build",
    "storybook-run": "npx http-server storybook-static -p 6006",
    "storybook-test": "test-storybook --url http://localhost:6006"
  },
  "dependencies": {
    "@jgrieve/forms": "^0.0.1-alpha.1",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@zephyrex/auth": "^0.0.1-alpha.1",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "zephyrex": "^1.0.0-alpha.1",
    "zod": "^4.6.5",
    "zod2gql": "^0.1.0-alpha.1"
  },
  "dependenciesMeta": {
    "zephyrex": {
      "injected": true
    },
    "@zephyrex/auth": {
      "injected": true
    },
    "@jgrieve/forms": {
      "injected": true
    },
    "zod2gql": {
      "injected": true
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/test-runner": "^0.24.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.7",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.2"
  }
}
